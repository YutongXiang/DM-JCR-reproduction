	xplGlobal.document.metadata={"userInfo":{"institute":false,"member":false,"individual":false,"guest":false,"subscribedContent":false,"fileCabinetContent":false,"fileCabinetUser":false,"dtrDeleteCookieOnLogout":false,"institutionalFileCabinetUser":false,"dtrCookieExpirationDays":0,"showPatentCitations":true,"showGet802Link":false,"showOpenUrlLink":false,"tracked":false,"institutionUserId":0,"delegatedAdmin":false,"desktop":false,"isInstitutionDashboardEnabled":false,"isInstitutionProfileEnabled":false,"isRoamingEnabled":false,"isDelegatedAdmin":false,"isMdl":false,"isCwg":false,"isReadAndPublish":false,"isIel":false,"isAcademic":false},"authors":[{"name":"Xiaoming Yuan","affiliation":["Hebei Key Laboratory of Marine Perception Network and Data Processing, Northeastern University, Qinhuangdao, China","State Key Laboratory of Integrated Services Networks, Xidian University, Xi’an, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/yuan-3656593-small.gif","p":["Xiaoming Yuan (Member, IEEE) received the Ph.D. degree in communication and information system from Xidian University, Xi’an, China, in 2018. From 2016 to 2017, she was a Visiting Scholar with the Broadband Communications Research (BBCR) Group, University of Waterloo, Waterloo, ON, Canada. From 2022 to 2024, she was a Postdoctoral Researcher with the School of Computer Science and Engineering, Nanyang Technological University, Singapore. She is currently an Associate Professor with Qinhuangdao Branch Campus, Northeastern University, Shenyang, China. Her research interests include edge intelligence, network management, intelligent connected vehicles, and generative AI."]},"firstName":"Xiaoming","lastName":"Yuan","orcid":"0000-0001-8006-364X","id":"37085646998"},{"name":"Songyu Wang","affiliation":["Hebei Key Laboratory of Marine Perception Network and Data Processing, Northeastern University, Qinhuangdao, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/wang-3656593-small.gif","p":["Songyu Wang received the B.E. degree in computer science and technology from Yanshan University, Qinhuangdao, China. He is currently working toward the master’s degree in computer technology with Qinhuangdao Branch Campus, Northeastern University, Qinhuangdao, China. His research interests include mobile edge computing and AIGC."]},"firstName":"Songyu","lastName":"Wang","orcid":"0009-0008-0408-050X","id":"37088513487"},{"name":"Jiaxin Zhou","affiliation":["Hebei Key Laboratory of Marine Perception Network and Data Processing, Northeastern University, Qinhuangdao, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/zhou-3656593-small.gif","p":["Jiaxin Zhou received the B.E. degree in computer science and technology from the University of Jinan, Jinan, China. She is currently working toward the master’s degree in computer technology with Qinhuangdao Branch Campus, Northeastern University, Qinhuangdao, China. Her research focuses on AIGC."]},"firstName":"Jiaxin","lastName":"Zhou","orcid":"0009-0008-7990-2897","id":"37087542935"},{"name":"Hongyang Du","affiliation":["Department of Electrical and Electronic Engineering, University of Hong Kong, Hong Kong SAR, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/du-3656593-small.gif","p":["Hongyang Du received the Ph.D. degree from Nanyang Technological University, Singapore. He is currently an Assistant Professor with the Department of Electrical and Electronic Engineering, The University of Hong Kong. His research interests include edge intelligence, generative AI, and network management. He was the recipient of the IEEE ComSoc Young Professional Award for Best Early Career Researcher in 2024, IEEE Daniel E. Noble Fellowship Award from the IEEE Vehicular Technology Society in 2022, IEEE Signal Processing Society Scholarship from the IEEE Signal Processing Society in 2023, Singapore Data Science Consortium (SDSC) Dissertation Research Fellowship in 2023, and NTU Graduate College’s Research Excellence Award in 2024. He was recognized as an Exemplary Reviewer of IEEE Transactions on Communications and IEEE Communications Letters."]},"firstName":"Hongyang","lastName":"Du","orcid":"0000-0002-8220-6525","id":"37087086303"},{"name":"Hongwei Ding","affiliation":["Hebei Key Laboratory of Marine Perception Network and Data Processing, Northeastern University, Qinhuangdao, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/ding-3656593-small.gif","p":["Hongwei Ding received the Ph.D. degree from the School of Cyber Science and Engineering, Wuhan University, Wuhan, China, in 2023. He is currently a Lecturer with Northeastern University, Qinhuangdao, China. His research interests include data mining, image processing, generative adversarial networks, and imbalanced learning."]},"firstName":"Hongwei","lastName":"Ding","orcid":"0009-0002-7074-7014","id":"37090052602"},{"name":"Qingxu Deng","affiliation":["School of Computer Science and Engineering, Northeastern University, Shenyang, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/deng-3656593-small.gif","p":["Qingxu Deng (Senior Member, IEEE) received the Ph.D. degree in computer science from Northeastern University, Shenyang, China, in 1997. He is currently a Professor with the School of Computer Science and Engineering, Northeastern University. His research interests include cyber-physical systems, embedded systems, and real-time systems."]},"firstName":"Qingxu","lastName":"Deng","orcid":"0000-0002-5185-6306","id":"37319889900"},{"name":"Changle Li","affiliation":["State Key Laboratory of Integrated Services Networks, Xidian University, Xi’an, China"],"bio":{"graphic":"/mediastore/IEEE/content/freeimages/25/11614322/11359991/li-3656593-small.gif","p":["Changle Li (Senior Member, IEEE) received the Ph.D. degree in communication and information system from Xidian University, Xi’an, China, in 2005. He conducted his Postdoctoral Research in Canada and also with the National Institute of information and Communications Technology, Koganei, Japan. He has been a Visiting Scholar with the University of Technology Sydney, Ultimo, NSW, Australia. He is currently a Professor with the State Key Laboratory of Integrated Services Networks, Xidian University. His research interests include intelligent transportation systems, vehicular networks, mobile ad hoc networks, and wireless sensor networks."]},"firstName":"Changle","lastName":"Li","orcid":"0000-0003-2568-8908","id":"37278179200"}],"issn":[{"format":"Print ISSN","value":"0018-9545"},{"format":"Electronic ISSN","value":"1939-9359"}],"articleNumber":"11359991","mediaPath":"/mediastore/IEEE/content/media/25/11614322/11359991","dbTime":"3 ms","metrics":{"wosCitationCount":0,"citationCountPaper":1,"citationCountPatent":0,"totalDownloads":200},"purchaseOptions":{"showOtherFormatPricingTab":false,"showPdfFormatPricingTab":true,"pdfPricingInfoAvailable":false,"otherPricingInfoAvailable":false,"mandatoryBundle":false,"optionalBundle":false,"displayTextWhenPdfPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information.","displayTextWhenOtherFormatPricingNotAvailable":"The purchase and pricing options for this item are unavailable. Select items are only available as part of a subscription package. You may try again later or <a href='https://ieeexplore.ieee.org/xpl/contact' target='_blank'>contact us</a> for more information."},"getProgramTermsAccepted":false,"sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"true","relatedContent":"false","metrics":"true"},"abstract":"Edge computing significantly enhances the data processing efficiency and response speed of Connected and Autonomous vehicles (CAVs) by offloading computing tasks to network edge nodes. However, critical challenges arise, including limited edge resources, the complexity of resource allocation strategies and signal obstruction caused by buildings. Existing approaches often address communication and computing resources allocation separately, which hinders their ability to fulfill the stringent latency and reliability demands of CAVs. To tackle these challenges, this paper first employs Uncrewed Aerial Vehicles (UAVs) as both communication relay nodes and mobile edge computing nodes, establishing a unique CAVs communication architecture. Based on the architecture, this paper proposes the DM-JCR algorithm grounded in the diffusion model, which is designed to optimize the joint allocation of communication and computing resources in edge computing nodes. Specifically, the algorithm uses environmental information category as a prompt to guide the diffusion model to generate an optimized joint allocation strategy for communication and computing resources. The denoising process of the diffusion model is improved based on the practical requirements of the joint communication and computing resources allocation problem. Finally, the DM-JCR algorithm is deployed in the proposed architecture to validate its effectiveness. Experimental results show that the proposed algorithm achieves superior performance compared to baseline methods in both latency and energy consumption.","publicationYear":"2026","publicationTitle":"IEEE Transactions on Vehicular Technology","publicationDate":"July 2026","pdfPath":"/iel8/25/11614322/11359991.pdf","formulaStrippedArticleTitle":"DM-JCR: Diffusion Model-Based Approaches for Joint Allocation of Communication and Computing Resources","pdfUrl":"/stamp/stamp.jsp?tp=&arnumber=11359991","startPage":"14564","endPage":"14579","displayPublicationTitle":"IEEE Transactions on Vehicular Technology","keywords":[{"type":"IEEE Keywords","kwd":["Resource management","Diffusion models","Optimization","Heuristic algorithms","Computer architecture","Vehicle dynamics","Computational modeling","Noise reduction","Energy consumption","Buildings"]},{"type":"Index Terms","kwd":["Resource Allocation","Computational Resources","Communication Resources","Joint Allocation","Allocation For Communication","Joint Allocation Of Communication","Energy Consumption","Diffusion Model","Unmanned Aerial Vehicles","Autonomous Vehicles","Allocation Scheme","Computation Tasks","Category Information","Edge Computing","Edge Nodes","Resource Allocation Scheme","Resource Allocation Problem","Relay Nodes","Computation Resource Allocation","Iterative Process","Task Offloading","Vehicular Communication","Reversible Process","Vehicular Networks","Efficient Allocation","Inference Phase","Large-scale Scenarios","Time Slot","Dynamic Environment","Consumption Index"]},{"type":"Author Keywords","kwd":["Diffusion model","connected and autonomous vehicles","Uncrewed aerial vehicle","resource allocation","edge computing"]}],"authorNames":"Xiaoming Yuan;Songyu Wang;Jiaxin Zhou;Hongyang Du;Hongwei Ding;Qingxu Deng;Changle Li","articleCopyRight":"2026 IEEE","rightsLink":"http://s100.copyright.com/AppDispatchServlet?publisherName=ieee&publication=25&title=DM-JCR%3A+Diffusion+Model-Based+Approaches+for+Joint+Allocation+of+Communication+and+Computing+Resources&isbn=&publicationDate=July+2026&author=Xiaoming+Yuan&ContentID=10.1109/TVT.2026.3656593&orderBeanReset=true&startPage=14564&endPage=14579&volumeNum=75&issueNum=7","displayPublicationDate":"21 January 2026","dateOfInsertion":"21 January 2026","allowComments":false,"pubLink":"/xpl/RecentIssue.jsp?punumber=25","issueLink":"/xpl/tocresult.jsp?isnumber=11614322&punumber=25","doiLink":"https://doi.org/10.1109/TVT.2026.3656593","isGetAddressInfoCaptured":false,"isMarketingOptIn":false,"pubTopics":[{"name":"Transportation"},{"name":"Aerospace"}],"publisher":"IEEE","displayDocTitle":"DM-JCR: Diffusion Model-Based Approaches for Joint Allocation of Communication and Computing Resources","isChapter":false,"isDynamicHtml":true,"xploreDocumentType":"Journals & Magazine","isTutorial":false,"isPromo":false,"isBook":false,"volume":"75","isBookWithoutChapters":false,"isStandard":false,"isOnlineOnly":false,"isFreeDocument":false,"issue":"7","isEarlyAccess":false,"isOpenAccess":false,"isEphemera":false,"isConference":false,"isProduct":false,"isSpringer":false,"isJournal":true,"isCustomDenial":false,"isNow":false,"isDegruyter":false,"isSMPTE":false,"isOUP":false,"htmlLink":"/document/11359991/","htmlAbstractLink":"/document/11359991/","isLatestStandard":false,"hasStandardVersions":false,"isGiveaway":false,"isTranslation":false,"isSAE":false,"persistentLink":"https://xplorestaging.ieee.org/servlet/opac?punumber=25","startPage":"14564","fundingAgencies":{"fundingAgency":[{"fundingId":"10.13039/501100001809","fundingName":"National Natural Science Foundation of China","grantNumber":"62371116"}]},"articleCopyRight":"2026 IEEE","openAccessFlag":"F","insertDate":"21 January 2026","ephemeraFlag":"false","title":"DM-JCR: Diffusion Model-Based Approaches for Joint Allocation of Communication and Computing Resources","html_flag":"false","ml_html_flag":"true","sourcePdf":"tvt-yuan-3656593-x.pdf","displayPublicationDate":"21 January 2026","mlTime":"PT0.075623S","xplore-pub-id":"25","pdfPath":"/iel8/25/11614322/11359991.pdf","sponsors":[{"name":"IEEE Vehicular Technology Society","url":"http://www.vtsociety.org/"}],"isNumber":"11614322","rightsLinkFlag":"1","contentType":"periodicals","publicationDate":"July 2026","publicationNumber":"25","citationCount":"1","xplore-issue":"11614322","issue":"7","articleId":"11359991","publicationTitle":"IEEE Transactions on Vehicular Technology","sections":{"abstract":"true","authors":"true","disclaimer":"false","figures":"true","multimedia":"false","references":"true","citedby":"true","keywords":"true","definitions":"false","algorithm":"false","dataset":"false","cadmore":"false","footnotes":"true","relatedContent":"false","metrics":"true"},"volume":"75","contentTypeDisplay":"Journals","referenceCount":40,"publicationYear":"2026","subType":"IEEE Transaction","_value":"IEEE","lastupdate":"2026-09-06","mediaPath":"/mediastore/IEEE/content/media/25/11614322/11359991","endPage":"14579","displayPublicationTitle":"IEEE Transactions on Vehicular Technology","doi":"10.1109/TVT.2026.3656593"};








